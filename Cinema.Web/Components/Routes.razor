<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <div class="container py-5 text-center">
                        <div class="card shadow-sm border-0 mx-auto" style="max-width: 500px; border-radius: 16px;">
                            <div class="card-body p-4 p-md-5">
                                <div class="text-danger mb-3" style="font-size: 3rem;">
                                    🔒
                                </div>
                                <h3 class="fw-bold">Yêu Cầu Quyền Quản Trị</h3>
                                <p class="text-muted">Bạn cần đăng nhập tài khoản Quản trị viên để truy cập trang chức năng này.</p>
                                <a href="/login" class="btn btn-primary px-4 py-2 mt-2" style="border-radius: 10px;">
                                    Đăng Nhập Quản Trị Viên
                                </a>
                            </div>
                        </div>
                    </div>
                </NotAuthorized>
                <Authorizing>
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Đang tải...</span>
                        </div>
                        <p class="text-muted mt-2">Đang xác thực thông tin...</p>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(Layout.MainLayout)">
                <div class="container py-5 text-center">
                    <h1 class="display-4 fw-bold text-muted">404</h1>
                    <p class="lead">Trang bạn tìm kiếm không tồn tại hoặc đã bị di dời.</p>
                    <a href="/" class="btn btn-primary">Trở về Trang Chủ</a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

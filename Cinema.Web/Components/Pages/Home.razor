@page "/"
@inject IViewMoviesUseCase ViewMoviesUseCase
@inject IViewShowtimesUseCase ViewShowtimesUseCase
@inject NavigationManager Navigation

<PageTitle>CineStar Huế - Phim Đang Chiếu &amp; Lịch Chiếu</PageTitle>

<!-- Hero Section Dark Cinema -->
<section class="py-4 py-md-5 mb-4 position-relative overflow-hidden" 
         style="background: radial-gradient(circle at 80% 20%, #1e1b4b 0%, #0b0f19 75%); border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
    <div class="container position-relative" style="z-index: 2;">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" 
                     style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.3); color: #fbbf24; font-size: 0.85rem; font-weight: 800; letter-spacing: 0.5px;">
                    <i class="bi bi-stars"></i> RẠP PHIM ĐẲNG CẤP QUỐC TẾ TẠI HUẾ
                </div>
                <h1 class="display-5 fw-extrabold text-white mb-3" style="font-weight: 800; letter-spacing: -1px;">
                    Chọn Ghế Nhanh Chóng &amp; <br /><span style="color: #f59e0b;">Trải Nghiệm Điện Ảnh</span> Đỉnh Cao
                </h1>
                <p class="lead mb-4" style="color: #94a3b8; font-size: 1.15rem; max-width: 650px;">
                    Thưởng thức bom tấn điện ảnh với chuẩn âm thanh <strong>Dolby Atmos</strong> và màn chiếu cực đại <strong>IMAX Laser</strong>. Chọn vị trí ngồi yêu thích chỉ trong vài thao tác trực quan!
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="#movies-section" class="btn btn-cinema-gold btn-lg px-4 py-3 d-flex align-items-center gap-2">
                        <i class="bi bi-ticket-perforated-fill fs-5"></i>
                        <span>Xem Phim &amp; Đặt Vé Ngay</span>
                    </a>
                    <a href="/lookup" class="btn btn-outline-light btn-lg px-4 py-3 d-flex align-items-center gap-2" 
                       style="border-radius: 10px; font-weight: 700; border-color: rgba(255, 255, 255, 0.2); background: rgba(255, 255, 255, 0.05);">
                        <i class="bi bi-search"></i>
                        <span>Tra Cứu Vé Đã Đặt</span>
                    </a>
                </div>
            </div>
            <div class="col-lg-4 text-center d-none d-lg-block">
                <div class="card p-3 shadow-lg border-0" 
                     style="background: rgba(17, 24, 39, 0.85); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.1) !important; border-radius: 22px; transform: rotate(2deg);">
                    <img src="https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=600&auto=format&fit=crop&q=80" 
                         alt="Cinema banner" class="img-fluid rounded-3" style="height: 240px; object-fit: cover;">
                    <div class="mt-3 text-start">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-danger px-2 py-1 fw-bold">ĐANG CHIẾU</span>
                            <span class="text-warning fw-bold"><i class="bi bi-star-fill me-1"></i>9.8 / 10</span>
                        </div>
                        <h6 class="fw-bold text-white mt-2 mb-0">CineStar Huế - Dolby Atmos</h6>
                        <small class="text-secondary" style="color: #94a3b8 !important;">Phòng chiếu tiêu chuẩn quốc tế</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- AI Assistant Section -->
<!-- Main Movies List -->
<div class="container my-5" id="movies-section">
    <!-- Header with Date Filters -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3" 
         style="border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
        <div>
            <h2 class="fw-bold text-white mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-camera-reels-fill text-warning"></i>
                <span>Phim Đang Chiếu</span>
            </h2>
            <p class="mb-0" style="color: #94a3b8;">Chọn suất chiếu phù hợp để xem sơ đồ phòng và chọn ghế ngồi yêu thích.</p>
        </div>

        <div class="btn-group p-1 rounded-pill" style="background: #111827; border: 1px solid rgba(255, 255, 255, 0.1);">
            <button class="btn btn-sm rounded-pill px-3 @(_selectedDateFilter == 0 ? "btn-warning fw-bold text-dark" : "btn-link text-white-50 text-decoration-none")"
                    @onclick="() => FilterByDate(0)">
                Hôm Nay (@DateTime.Today.ToString("dd/MM"))
            </button>
            <button class="btn btn-sm rounded-pill px-3 @(_selectedDateFilter == 1 ? "btn-warning fw-bold text-dark" : "btn-link text-white-50 text-decoration-none")"
                    @onclick="() => FilterByDate(1)">
                Ngày Mai (@DateTime.Today.AddDays(1).ToString("dd/MM"))
            </button>
            <button class="btn btn-sm rounded-pill px-3 @(_selectedDateFilter == 2 ? "btn-warning fw-bold text-dark" : "btn-link text-white-50 text-decoration-none")"
                    @onclick="() => FilterByDate(2)">
                Tất Cả Suất Chiếu
            </button>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-warning" role="status">
                <span class="visually-hidden">Đang tải danh sách phim...</span>
            </div>
            <p class="mt-2" style="color: #94a3b8;">Đang tải lịch chiếu phim từ hệ thống...</p>
        </div>
    }
    else if (!_movies.Any())
    {
        <div class="alert alert-dark text-center py-4 border-secondary text-white">
            <i class="bi bi-info-circle-fill me-2 fs-5 text-warning"></i>Hiện tại chưa có suất chiếu nào trong khoảng thời gian này.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var movie in _movies)
            {
                var movieShowtimes = _showtimes.Where(s => s.MovieId == movie.MovieId).OrderBy(s => s.StartTime).ToList();

                <div class="col-12 col-md-6 col-lg-6">
                    <div class="card movie-card h-100">
                        <div class="row g-0 h-100">
                            <!-- Left: Poster -->
                            <div class="col-5 col-sm-4 position-relative">
                                <div class="movie-poster-wrap h-100">
                                    <img src="@movie.PosterUrl" alt="@movie.Title" class="movie-poster-img" />
                                    <span class="age-badge @GetAgeBadgeClass(movie.AgeRating)">
                                        @movie.AgeRating
                                    </span>
                                </div>
                            </div>

                            <!-- Right: Movie Details & Showtimes -->
                            <div class="col-7 col-sm-8 p-3 p-sm-4 d-flex flex-column justify-content-between">
                                <div>
                                    <h4 class="fw-bold text-white mb-1" style="font-size: 1.25rem;">@movie.Title</h4>
                                    <div class="d-flex flex-wrap gap-2 small mb-2" style="color: #94a3b8;">
                                        <span><i class="bi bi-clock me-1 text-warning"></i>@movie.DurationMinutes phút</span>
                                        <span>•</span>
                                        <span>@movie.Genre</span>
                                    </div>
                                    <p class="small mb-3 text-secondary text-truncate-3" style="color: #cbd5e1 !important; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                        @movie.Description
                                    </p>
                                    <div class="small mb-2" style="color: #94a3b8;">
                                        <strong>Đạo diễn:</strong> @movie.Director<br />
                                        <strong>Diễn viên:</strong> @movie.Cast
                                    </div>
                                </div>

                                <!-- Showtimes Section -->
                                <div class="mt-3 pt-2" style="border-top: 1px solid rgba(255, 255, 255, 0.08);">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="small fw-bold text-warning text-uppercase" style="letter-spacing: 0.5px;">
                                            <i class="bi bi-calendar2-week me-1"></i>Suất Chiếu
                                        </span>
                                        <small style="color: #64748b;">Chọn suất để xem ghế</small>
                                    </div>

                                    @if (!movieShowtimes.Any())
                                    {
                                        <div class="small fst-italic py-1" style="color: #64748b;">
                                            Chưa có suất chiếu trong ngày đã chọn.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var st in movieShowtimes)
                                            {
                                                <a href="/booking/@st.ShowtimeId" class="showtime-pill">
                                                    <span>@st.StartTime.ToString("HH:mm")</span>
                                                    <span class="screen-tag">@st.ScreenType</span>
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Movie> _movies = new();
    private List<Showtime> _showtimes = new();
    private bool _isLoading = true;
    private int _selectedDateFilter = 0; // 0 = Hôm nay, 1 = Ngày mai, 2 = Tất cả

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task FilterByDate(int filterOption)
    {
        _selectedDateFilter = filterOption;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            var movies = (await ViewMoviesUseCase.ExecuteAsync(activeOnly: true)).ToList();
            _movies = movies;

            if (_selectedDateFilter == 2)
            {
                _showtimes = (await ViewShowtimesUseCase.ExecuteAllAsync()).ToList();
            }
            else
            {
                var targetDate = _selectedDateFilter == 0 ? DateTime.Today : DateTime.Today.AddDays(1);
                _showtimes = (await ViewShowtimesUseCase.ExecuteByDateAsync(targetDate)).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading movies: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetAgeBadgeClass(string? rating) => rating?.ToUpper() switch
    {
        "T18" => "age-badge-t18",
        "T16" => "age-badge-t16",
        "T13" => "age-badge-t13",
        "K"   => "age-badge-k",
        "P"   => "age-badge-p",
        _     => "bg-secondary"
    };
}

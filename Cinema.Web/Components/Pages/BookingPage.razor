@page "/booking/{ShowtimeId:int}"
@inject IViewShowtimesUseCase ViewShowtimesUseCase
@inject ICreateBookingUseCase CreateBookingUseCase
@inject UserSessionService UserSession
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Chọn Ghế &amp; Đặt Vé - Starlight Cinema Huế</PageTitle>

<div class="container py-4">
    <!-- Breadcrumb & Back button -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <a href="/" class="btn btn-outline-light btn-sm d-flex align-items-center gap-1" 
           style="border-color: rgba(255,255,255,0.2); background: rgba(255,255,255,0.05); color: #cbd5e1;">
            <i class="bi bi-arrow-left"></i>
            <span>Trở Về Danh Sách Phim</span>
        </a>
        <div class="student-tag small">
            <i class="bi bi-check2-circle text-warning me-1"></i>Đề tài 14: Chọn ghế &amp; Đặt vé
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Đang tải suất chiếu...</span>
            </div>
            <p class="text-muted mt-2">Đang tải sơ đồ phòng chiếu...</p>
        </div>
    }
    else if (_showtime == null)
    {
        <div class="alert alert-danger text-center py-5">
            <i class="bi bi-exclamation-triangle fs-2 text-danger d-block mb-2"></i>
            <h4>Không tìm thấy suất chiếu</h4>
            <p class="text-muted">Suất chiếu này không tồn tại hoặc đã bị gỡ khỏi lịch chiếu.</p>
            <a href="/" class="btn btn-primary mt-2">Quay Lại Trang Chủ</a>
        </div>
    }
    else
    {
        <!-- Movie & Showtime Info Bar -->
        <div class="card card-clean p-3 p-md-4 mb-4">
            <div class="row align-items-center g-3">
                <div class="col-auto">
                    <img src="@_showtime.MoviePosterUrl" alt="@_showtime.MovieTitle" 
                         class="rounded shadow-sm" style="width: 70px; height: 100px; object-fit: cover;" />
                </div>
                <div class="col">
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        <span class="badge bg-danger fw-bold">@_showtime.MovieAgeRating</span>
                        <span class="badge bg-dark border border-secondary text-light">@_showtime.ScreenType</span>
                        <span class="badge bg-secondary-subtle text-secondary">
                            <i class="bi bi-clock me-1"></i>@_showtime.MovieDurationMinutes phút
                        </span>
                    </div>
                    <h3 class="fw-bold mb-1 text-white">@_showtime.MovieTitle</h3>
                    <div class="text-muted small">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i><strong>@_showtime.AuditoriumName</strong>
                        <span class="mx-2">•</span>
                        <i class="bi bi-calendar-event text-primary me-1"></i>
                        <span class="text-white fw-bold">@_showtime.StartTime.ToString("HH:mm - dddd, dd/MM/yyyy")</span>
                    </div>
                </div>
            </div>
        </div>

        @if (_isPastShowtime)
        {
            <div class="alert alert-warning py-3 mb-4 d-flex align-items-center gap-3">
                <i class="bi bi-exclamation-octagon-fill fs-3 text-warning"></i>
                <div>
                    <strong>Suất chiếu này đã diễn ra hoặc đã kết thúc!</strong>
                    <div class="small text-muted">Hệ thống đã khóa tính năng đặt vé cho suất chiếu này. Vui lòng chọn một suất chiếu khác trong tương lai.</div>
                </div>
            </div>
        }

        <!-- Main Booking Workspace -->
        <div class="row g-4">
            <!-- Left: Seat Map Matrix Component (Reuseable Control) -->
            <div class="col-lg-8">
                <div class="card card-clean p-3 p-md-4">
                    <SeatMapComponent @ref="_seatMapRef" 
                                      ShowtimeId="@ShowtimeId" 
                                      BasePrice="@_showtime.BasePrice" 
                                      IsDisabled="@_isPastShowtime"
                                      OnSelectionChanged="HandleSelectionChanged" />
                </div>
            </div>

            <!-- Right: Booking Summary & Checkout Form -->
            <div class="col-lg-4">
                <div class="card card-clean p-3 p-md-4 sticky-top" style="top: 80px; z-index: 10;">
                    <h5 class="fw-bold text-white mb-3 d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-receipt text-warning me-2"></i>Tóm Tắt Đặt Vé</span>
                        <span class="badge bg-primary">@_selectedSeats.Count ghế</span>
                    </h5>

                    <!-- Selected Seats Badges -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted mb-1">Ghế Đang Chọn:</label>
                        @if (_selectedSeats.Count == 0)
                        {
                            <div class="text-white-50 small fst-italic p-2 rounded bg-dark border border-secondary border-opacity-25">
                                Chưa chọn ghế nào. Vui lòng bấm vào sơ đồ bên trái để chọn ghế.
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-1 p-2 rounded bg-dark border border-secondary border-opacity-25">
                                @foreach (var seat in _selectedSeats)
                                {
                                    <span class="badge bg-warning text-dark px-2 py-1 font-monospace fw-bold">
                                        @seat.SeatDisplayName (@seat.SeatType)
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <!-- Price Calculation Breakdown -->
                    <div class="border-top border-secondary border-opacity-25 pt-3 mb-3">
                        <div class="d-flex justify-content-between small text-muted mb-1">
                            <span>Giá vé cơ bản:</span>
                            <span class="text-light">@_showtime.BasePrice.ToString("N0") đ/vé</span>
                        </div>
                        <div class="d-flex justify-content-between small text-muted mb-2">
                            <span>Số lượng:</span>
                            <span class="text-light">@_selectedSeats.Count vé</span>
                        </div>

                        <!-- Grand Total Box -->
                        <div class="d-flex justify-content-between align-items-center py-3 px-3 rounded-3 mb-3" 
                             style="background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.3);">
                            <span class="fw-bold text-warning">TỔNG TIỀN:</span>
                            <span class="fs-4 fw-extrabold text-warning" style="font-weight: 800;">
                                @_totalAmount.ToString("N0") đ
                            </span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(_bookingError))
                    {
                        <div class="alert alert-danger small py-2 mb-3">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>@_bookingError
                        </div>
                    }

                    <!-- Customer Information Form (EditForm + DataAnnotations) -->
                    <EditForm Model="@_bookingModel" OnValidSubmit="HandleSubmitBooking">
                        <DataAnnotationsValidator />

                        <div class="mb-2">
                            <label class="form-label small fw-bold mb-1" style="color: #cbd5e1;">Họ &amp; Tên Người Đặt *</label>
                            <InputText class="form-control form-control-sm" 
                                       placeholder="Ví dụ: Nguyễn Văn An" 
                                       @bind-Value="_bookingModel.CustomerName" />
                            <ValidationMessage For="@(() => _bookingModel.CustomerName)" class="text-danger small mt-1" />
                        </div>

                        <div class="mb-2">
                            <label class="form-label small fw-bold mb-1" style="color: #cbd5e1;">Số Điện Thoại *</label>
                            <InputText type="tel" class="form-control form-control-sm" 
                                       placeholder="0905123456" 
                                       @bind-Value="_bookingModel.CustomerPhone" />
                            <ValidationMessage For="@(() => _bookingModel.CustomerPhone)" class="text-danger small mt-1" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold mb-1" style="color: #cbd5e1;">Email Nhận Vé Điện Tử *</label>
                            <InputText type="email" class="form-control form-control-sm" 
                                       placeholder="nguyenvanan@gmail.com" 
                                       @bind-Value="_bookingModel.CustomerEmail" />
                            <ValidationMessage For="@(() => _bookingModel.CustomerEmail)" class="text-danger small mt-1" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold mb-1" style="color: #cbd5e1;">Phương thức thanh toán</label>
                            <select class="form-select form-select-sm" @bind="_bookingModel.PaymentMethod">
                                <option value="VNPAY-QR">VNPAY-QR (Quét mã thanh toán tức thì)</option>
                                <option value="ATM / Thẻ Nội Địa">Thẻ ATM / Tài Khoản Ngân Hàng</option>
                                <option value="Ví MoMo">Ví Điện Tử MoMo</option>
                            </select>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" 
                                class="btn btn-cinema-gold w-100 py-3 fw-bold" 
                                disabled="@(_selectedSeats.Count == 0 || _isSubmitting || _isPastShowtime)">
                            @if (_isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2 text-dark"></span>
                                <span>Đang xử lý đặt vé...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle-fill me-2"></i>
                                <span>Xác Nhận &amp; Đặt Vé (@_totalAmount.ToString("N0") đ)</span>
                            }
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int ShowtimeId { get; set; }

    private SeatMapComponent? _seatMapRef;
    private Showtime? _showtime;
    private List<SeatDto> _selectedSeats = new();
    private decimal _totalAmount = 0;
    private bool _isLoading = true;
    private bool _isSubmitting = false;
    private bool _isPastShowtime = false;
    private string? _bookingError;

    private Booking _bookingModel = new()
    {
        CustomerName = "",
        CustomerEmail = "",
        CustomerPhone = "",
        PaymentMethod = "VNPAY-QR"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadShowtimeAsync();
        await PreloadUserDataAsync();
    }

    private async Task PreloadUserDataAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                if (string.IsNullOrWhiteSpace(_bookingModel.CustomerName))
                    _bookingModel.CustomerName = user.Identity.Name ?? "";

                if (string.IsNullOrWhiteSpace(_bookingModel.CustomerEmail))
                    _bookingModel.CustomerEmail = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";

                if (string.IsNullOrWhiteSpace(_bookingModel.CustomerPhone))
                    _bookingModel.CustomerPhone = user.FindFirst("PhoneNumber")?.Value ?? "";

                if (int.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var uId))
                    _bookingModel.UserId = uId;
            }
        }
        catch
        {
            // Ignore if auth check is delayed
        }
    }

    private async Task LoadShowtimeAsync()
    {
        _isLoading = true;
        try
        {
            _showtime = await ViewShowtimesUseCase.ExecuteGetByIdAsync(ShowtimeId);
            if (_showtime != null)
            {
                _bookingModel.ShowtimeId = ShowtimeId;
                if (_showtime.StartTime <= DateTime.Now)
                {
                    _isPastShowtime = true;
                }
            }
        }
        catch (Exception ex)
        {
            _bookingError = $"Lỗi khi tải thông tin suất chiếu: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void HandleSelectionChanged(List<SeatDto> selectedList)
    {
        _selectedSeats = selectedList;
        _totalAmount = selectedList.Sum(s => s.FinalPrice);
        StateHasChanged();
    }

    private async Task HandleSubmitBooking()
    {
        if (_showtime == null || _showtime.StartTime <= DateTime.Now)
        {
            _bookingError = "Suất chiếu này đã diễn ra hoặc không tồn tại, không thể đặt vé!";
            return;
        }

        if (!_selectedSeats.Any())
        {
            _bookingError = "Vui lòng chọn ít nhất 1 ghế trước khi thanh toán!";
            return;
        }

        if (string.IsNullOrWhiteSpace(_bookingModel.CustomerName) || 
            string.IsNullOrWhiteSpace(_bookingModel.CustomerPhone) || 
            string.IsNullOrWhiteSpace(_bookingModel.CustomerEmail))
        {
            _bookingError = "Vui lòng điền đầy đủ họ tên, số điện thoại và email!";
            return;
        }

        _isSubmitting = true;
        _bookingError = null;

        try
        {
            var seatIds = _selectedSeats.Select(s => s.SeatId).ToList();
            string bookingRef = await CreateBookingUseCase.ExecuteAsync(_bookingModel, seatIds, UserSession.SessionId);

            Navigation.NavigateTo($"/confirmation/{bookingRef}");
        }
        catch (SeatConflictException ex)
        {
            _bookingError = ex.Message;
            if (_seatMapRef != null)
            {
                await _seatMapRef.LoadSeatsAsync();
            }
        }
        catch (Exception ex)
        {
            _bookingError = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}

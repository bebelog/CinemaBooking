@using Cinema.UseCases.AI
@using Cinema.UseCases.DTOs
@inject ISemanticMovieSearchUseCase SemanticSearchUseCase
@inject NavigationManager Navigation

<!-- Floating Trigger Button (Góc dưới bên phải) -->
<button type="button" class="ai-floating-btn" @onclick="ToggleChat">
    <span class="spinner-grow spinner-grow-sm text-warning" role="status" style="width: 10px; height: 10px;"></span>
    <i class="bi bi-stars fs-5"></i>
    <span>Trợ Lý CineStar AI</span>
    @if (_isOpen)
    {
        <i class="bi bi-chevron-down ms-1"></i>
    }
</button>

<!-- Floating Popup Chat Window -->
@if (_isOpen)
{
    <div class="ai-chat-popup">
        <!-- Header -->
        <div class="ai-chat-header">
            <div class="d-flex align-items-center gap-2">
                <div class="rounded-circle d-flex align-items-center justify-content-center" 
                     style="width: 36px; height: 36px; background: linear-gradient(135deg, #ec4899, #8b5cf6);">
                    <i class="bi bi-robot text-white"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold text-white">Trợ Lý AI Điện Ảnh</h6>
                    <div class="d-flex align-items-center gap-1 mt-1"><span class="badge bg-primary bg-opacity-25 text-info border border-info border-opacity-25" style="font-size: 0.65rem;"><i class="bi bi-stars"></i> Powered by Google Gemini 2.5 Flash</span></div>
                </div>
            </div>
            <button type="button" class="btn btn-sm btn-link text-white-50 p-0 text-decoration-none fs-5" @onclick="ToggleChat">
                <i class="bi bi-x-circle"></i>
            </button>
        </div>

        <!-- Chat Body -->
        <div class="ai-chat-body">
            <!-- Welcome message bubble -->
            <div class="p-3 rounded-4 mb-3" style="background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(255, 255, 255, 0.08);">
                <div class="d-flex align-items-center gap-2 mb-1 text-warning fw-bold small">
                    <i class="bi bi-stars"></i>
                    <span>CineStar AI chào bạn!</span>
                </div>
                <div class="small" style="color: #e2e8f0; line-height: 1.5;">
                    Bạn muốn tìm phim thế nào? Hãy nói mong muốn của bạn (ví dụ: <em>"phim nhẹ nhàng cho gia đình"</em>, <em>"bom tấn tối nay"</em>) em sẽ gợi ý phim và suất chiếu hợp nhất!
                </div>
            </div>

            <!-- Quick Prompt Chips -->
            <div class="mb-3">
                <div class="small mb-2" style="color: #94a3b8; font-size: 0.78rem;">
                    <i class="bi bi-lightbulb me-1"></i>Gợi ý câu hỏi nhanh:
                </div>
                <div class="d-flex flex-wrap gap-1">
                    <button type="button" class="btn btn-sm text-nowrap rounded-pill py-1 px-2" 
                            style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); color: #cbd5e1; font-size: 0.78rem;"
                            @onclick='() => SetPrompt("phim nhẹ nhàng cho gia đình")'>
                        🍿 Phim nhẹ nhàng gia đình
                    </button>
                    <button type="button" class="btn btn-sm text-nowrap rounded-pill py-1 px-2" 
                            style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); color: #cbd5e1; font-size: 0.78rem;"
                            @onclick='() => SetPrompt("bom tấn hành động kịch tính tối nay")'>
                        💥 Bom tấn hành động tối nay
                    </button>
                    <button type="button" class="btn btn-sm text-nowrap rounded-pill py-1 px-2" 
                            style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); color: #cbd5e1; font-size: 0.78rem;"
                            @onclick='() => SetPrompt("phim tâm lý tình cảm sâu lắng")'>
                        ❤️ Phim tâm lý tình cảm
                    </button>
                </div>
            </div>

            <!-- AI Response Section -->
            @if (_isSearching)
            {
                <div class="text-center py-4">
                    <div class="spinner-border spinner-border-sm text-warning" role="status"></div>
                    <div class="small mt-2" style="color: #94a3b8;">AI đang đọc ngữ nghĩa và tìm suất chiếu...</div>
                </div>
            }
            else if (_hasSearched)
            {
                @if (_recommendations.Count == 0)
                {
                    <div class="alert alert-dark p-2 small border-secondary text-white rounded-3">
                        <i class="bi bi-info-circle me-1 text-warning"></i>
                        Chưa tìm thấy phim khớp câu này. Hãy thử từ khóa "gia đình", "hành động", "tình cảm" nhé!
                    </div>
                }
                else
                {
                    <div class="small fw-bold text-warning mb-2 d-flex align-items-center gap-1">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>AI Gợi Ý @(_recommendations.Count) Phim Phù Hợp:</span>
                    </div>

                    @foreach (var rec in _recommendations)
                    {
                        <div class="p-2 mb-2 rounded-3" style="background: rgba(30, 41, 59, 0.85); border: 1px solid rgba(255, 255, 255, 0.1);">
                            <div class="d-flex gap-2">
                                <img src="@rec.Movie.PosterUrl" alt="@rec.Movie.Title" 
                                     class="rounded-2 object-fit-cover" style="width: 50px; height: 70px;" />
                                <div class="flex-grow-1" style="min-width: 0;">
                                    <div class="d-flex align-items-center justify-content-between gap-1">
                                        <strong class="text-white small text-truncate">@rec.Movie.Title</strong>
                                        <span class="badge bg-success bg-opacity-75" style="font-size: 0.68rem;">
                                            @rec.RelevanceScore%
                                        </span>
                                    </div>
                                    <div class="small" style="font-size: 0.72rem; color: #94a3b8;">
                                        @rec.Movie.Genre | @rec.Movie.AgeRating
                                    </div>
                                    <div class="p-1 rounded mt-1" style="background: rgba(99, 102, 241, 0.15); font-size: 0.7rem; color: #cbd5e1;">
                                        <i class="bi bi-robot text-info me-1"></i>@rec.MatchReason
                                    </div>
                                </div>
                            </div>

                            <!-- Showtimes Chips -->
                            @if (rec.SuggestedShowtimes.Any())
                            {
                                <div class="mt-2 pt-2 border-top border-white border-opacity-10 d-flex flex-wrap gap-1 align-items-center">
                                    <small style="font-size: 0.68rem; color: #f59e0b;" class="fw-bold">Suất chiếu:</small>
                                    @foreach (var st in rec.SuggestedShowtimes.Take(3))
                                    {
                                        <a href="/booking/@st.ShowtimeId" 
                                           class="btn btn-sm btn-outline-warning py-0 px-2 rounded-pill fw-bold" 
                                           style="font-size: 0.7rem; text-decoration: none;">
                                            @st.StartTime.ToString("HH:mm")
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            }
        </div>

        <!-- Chat Input Footer -->
        <div class="ai-chat-footer">
            <div class="input-group">
                <input type="text" class="form-control form-control-sm border-0" 
                       style="background: #1e293b; color: #fff;"
                       placeholder="Nhập mong muốn xem phim..."
                       @bind="_query" 
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown" />
                <button class="btn btn-warning btn-sm fw-bold px-3 text-dark" 
                        type="button" 
                        disabled="@_isSearching"
                        @onclick="ExecuteSearch">
                    <i class="bi bi-send-fill"></i>
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _isOpen = false;
    private string _query = "";
    private bool _isSearching = false;
    private bool _hasSearched = false;
    private List<AiMovieRecommendationDto> _recommendations = new();

    private void ToggleChat()
    {
        _isOpen = !_isOpen;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ExecuteSearch();
        }
    }

    private async Task SetPrompt(string prompt)
    {
        _query = prompt;
        await ExecuteSearch();
    }

    private async Task ExecuteSearch()
    {
        if (string.IsNullOrWhiteSpace(_query)) return;

        _isSearching = true;
        _hasSearched = true;
        StateHasChanged();

        try
        {
            await Task.Delay(250);
            _recommendations = await SemanticSearchUseCase.ExecuteAsync(_query);
        }
        finally
        {
            _isSearching = false;
            StateHasChanged();
        }
    }
}
